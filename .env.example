# Copy to .env and fill in. Never commit .env — secrets are injected at
# deploy time, never stored in version control or a compose file (§8.1).

# The API and migrator both read this. Double underscore is the .NET
# configuration separator for environment variables.
ConnectionStrings__Wms=Host=localhost;Port=5432;Database=wms;Username=wms;Password=CHANGE_ME

POSTGRES_DB=wms
POSTGRES_USER=wms
POSTGRES_PASSWORD=CHANGE_ME
