{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(db/migrations/**)",
      "Edit(docs/**)",
      "Edit(web/**)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(db/migrations/**)",
      "Write(docs/**)",
      "Write(web/**)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet format*)",
      "Bash(dotnet restore*)",
      "Bash(npm install*)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(npx playwright*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(ls*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Bash(psql*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)"
    ],
    "ask": [
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(docker compose run*)",
      "Bash(git commit*)",
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-applied-migration.sh",
            "args": [],
            "timeout": 10,
            "statusMessage": "Checking migration immutability"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-fact-path.sh",
            "args": [],
            "timeout": 15,
            "statusMessage": "Checking WMS invariants"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-dotnet.sh",
            "args": [],
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  }
}
